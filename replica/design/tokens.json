{
  "_about": "Tokens de design do Sagaz. Dark-first, grafite com acento violeta. Papéis, não hex soltos; o sistema de componentes usa apenas esses papéis. Validação: python3 contrast.py tokens.json",
  "color": {
    "bg": "#0b0c0f",
    "surface": "#14161b",
    "surface-2": "#1b1e25",
    "border": "#262a33",
    "border-input": "#606875",
    "text": "#eef0f4",
    "text-muted": "#9aa2b1",
    "accent": "#8b7bff",
    "on-accent": "#0b0c0f",
    "danger": "#ff6b6b",
    "success": "#4ade80",
    "warning": "#fbbf24"
  },
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text", "surface-2"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["text-muted", "surface-2"],
    ["on-accent", "accent"],
    ["accent", "bg"],
    ["danger", "bg"],
    ["danger", "surface"],
    ["success", "bg"],
    ["success", "surface"],
    ["warning", "surface"],
    ["border-input", "bg", "ui"],
    ["accent", "surface", "ui"]
  ],
  "font": {
    "sans": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "type": {
    "xs": {"size": 11, "line": 16, "weight": 600},
    "sm": {"size": 13, "line": 18, "weight": 400},
    "base": {"size": 15, "line": 22, "weight": 400},
    "lg": {"size": 19, "line": 26, "weight": 600},
    "xl": {"size": 26, "line": 32, "weight": 700},
    "display": {"size": 34, "line": 40, "weight": 700}
  },
  "space": [0, 4, 8, 12, 16, 20, 24, 32, 48, 64],
  "radius": {"sm": 8, "md": 12, "lg": 18, "pill": 999},
  "shadow": {
    "card": "0 1px 2px rgba(0,0,0,.4)",
    "pop": "0 16px 40px rgba(0,0,0,.55)",
    "accent-glow": "0 8px 30px rgba(139,123,255,.25)"
  },
  "motion": {"fast": "120ms", "base": "180ms", "ease": "cubic-bezier(.2,.8,.2,1)"},
  "layout": {
    "maxWidth": 640,
    "headerHeight": 56,
    "safeBottom": "env(safe-area-inset-bottom, 0px)"
  }
}
